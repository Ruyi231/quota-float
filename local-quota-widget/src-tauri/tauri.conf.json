{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex 本地额度",
  "version": "1.3.4",
  "identifier": "local.codex.quota.widget",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "widget",
        "title": "Codex 本地额度",
        "width": 80,
        "height": 80,
        "minWidth": 80,
        "minHeight": 80,
        "maxWidth": 356,
        "maxHeight": 356,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false
  }
}
